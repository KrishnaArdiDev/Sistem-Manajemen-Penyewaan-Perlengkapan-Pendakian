<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sistemmanajemenpenyewaanperlengkapanpendakian.controller.MainLayoutController"
            prefWidth="1440.0"
            prefHeight="900.0"
            style="-fx-background-color: #F0F0F0;">

    <left>
        <VBox fx:id="paneVbox"
              prefWidth="290.0"
              minWidth="250.0"
              spacing="12.0"
              style="-fx-background-color: white;">

            <padding>
                <Insets top="12" right="16" bottom="12" left="16"/>
            </padding>

            <children>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <children>
                        <ImageView fitWidth="44"
                                   fitHeight="44"
                                   preserveRatio="true">
                            <image>
                                <Image url="@../../../images/Logo.png"/>
                            </image>
                        </ImageView>

                        <Label text="TAPAK"
                               style="-fx-font-size: 24px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: #005A32;"/>
                    </children>
                </HBox>

                <Pane minHeight="20" prefHeight="20"/>

                <Button fx:id="tombolDashboard"
                        text="Dashboard Admin"
                        onAction="#bukaDashboard"
                        maxWidth="Infinity"
                        minHeight="50"
                        style="-fx-background-color: #E5F3EB;
                               -fx-text-fill: #005A32;
                               -fx-font-weight: bold;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;
                               -fx-alignment: CENTER_LEFT;
                               -fx-padding: 0 12;"/>

                <Button fx:id="tombolDataPerleng"
                        text="Data Perlengkapan"
                        onAction="#bukaDataPerleng"
                        maxWidth="Infinity"
                        minHeight="50"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #005A32;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;
                               -fx-alignment: CENTER_LEFT;
                               -fx-padding: 0 12;"/>

                <Button fx:id="tombolPengembalian"
                        text="Pengembalian"
                        onAction="#bukaPengembalian"
                        maxWidth="Infinity"
                        minHeight="50"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #005A32;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;
                               -fx-alignment: CENTER_LEFT;
                               -fx-padding: 0 12;"/>

                <Button fx:id="tombolTransaksi"
                        text="Transaksi"
                        onAction="#bukaTransaksi"
                        maxWidth="Infinity"
                        minHeight="50"
                        style="-fx-background-color: transparent;
                               -fx-text-fill: #005A32;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;
                               -fx-alignment: CENTER_LEFT;
                               -fx-padding: 0 12;"/>

                <Pane VBox.vgrow="ALWAYS"/>

                <Button fx:id="tombolProfile"
                        onAction="#bukaProfile"
                        accessibleText="Buka Profil Admin"
                        maxWidth="Infinity"
                        minHeight="64"
                        focusTraversable="true"
                        style="-fx-background-color: #005A32;
                               -fx-background-radius: 10;
                               -fx-cursor: hand;
                               -fx-padding: 6 10;">

                    <graphic>
                        <HBox alignment="CENTER_LEFT"
                              spacing="10"
                              mouseTransparent="true">
                            <children>
                                <StackPane minWidth="44"
                                           minHeight="44"
                                           prefWidth="44"
                                           prefHeight="44">
                                    <children>
                                        <ImageView fx:id="fotoProfile"
                                                   fitWidth="44"
                                                   fitHeight="44"
                                                   preserveRatio="false"
                                                   smooth="true">
                                            <clip>
                                                <Circle centerX="22"
                                                        centerY="22"
                                                        radius="22"/>
                                            </clip>
                                        </ImageView>
                                    </children>
                                </StackPane>

                                <VBox alignment="CENTER_LEFT" spacing="4">
                                    <children>
                                        <Label text="WELCOME"
                                               style="-fx-font-size: 10px;
                                                      -fx-text-fill: #D7F5E2;"/>

                                        <Label text="ADMIN TOKO"
                                               style="-fx-font-size: 12px;
                                                      -fx-font-weight: bold;
                                                      -fx-text-fill: white;"/>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="tombolKeluar"
                        text="Keluar"
                        onAction="#keluar"
                        maxWidth="Infinity"
                        minHeight="46"
                        style="-fx-background-color: #FCE8E6;
                               -fx-text-fill: #B3261E;
                               -fx-background-radius: 9;
                               -fx-cursor: hand;"/>
            </children>
        </VBox>
    </left>

    <center>
        <BorderPane fx:id="layoutPage"
                    style="-fx-background-color: #F0F0F0;">

            <top>
                <HBox fx:id="headerContainer"
                      alignment="CENTER_LEFT"
                      spacing="18"
                      minHeight="76"
                      style="-fx-background-color: white;
                             -fx-background-radius: 0 0 14 14;">

                    <padding>
                        <Insets top="10" right="24" bottom="10" left="24"/>
                    </padding>

                    <children>
                        <HBox fx:id="searchContainer"
                              alignment="CENTER_LEFT"
                              spacing="10"
                              HBox.hgrow="ALWAYS">

                            <children>
                                <TextField fx:id="searchField"
                                           promptText="Masukkan perlengkapan yang ingin dicari..."
                                           maxWidth="Infinity"
                                           HBox.hgrow="ALWAYS"
                                           style="-fx-background-color: transparent;
                                                  -fx-border-color: transparent;
                                                  -fx-focus-color: transparent;
                                                  -fx-faint-focus-color: transparent;
                                                  -fx-padding: 8 4;"/>
                            </children>
                        </HBox>

                        <HBox fx:id="headerAction"
                              alignment="CENTER"
                              minWidth="44"
                              prefWidth="44">

                            <children>
                                <Button fx:id="tombolNotifikasi"
                                        accessibleText="Notifikasi"
                                        minWidth="44"
                                        minHeight="44"
                                        prefWidth="44"
                                        prefHeight="44"
                                        style="-fx-background-color: transparent;
                                               -fx-cursor: hand;
                                               -fx-padding: 8;">

                                    <graphic>
                                        <ImageView fx:id="iconNotifikasi"
                                                   fitWidth="24"
                                                   fitHeight="24"
                                                   preserveRatio="true"
                                                   smooth="true"
                                                   mouseTransparent="true">
                                            <image>
                                                <Image url="@../../../images/logo-notif.png"/>
                                            </image>
                                        </ImageView>
                                    </graphic>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </HBox>
            </top>

            <center>
                <StackPane fx:id="contentContainer"
                           style="-fx-background-color: #F0F0F0;">
                    <padding>
                        <Insets top="4" right="8" bottom="8" left="8"/>
                    </padding>
                </StackPane>
            </center>

        </BorderPane>
    </center>

</BorderPane>
