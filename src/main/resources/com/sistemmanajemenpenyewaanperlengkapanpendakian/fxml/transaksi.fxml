<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sistemmanajemenpenyewaanperlengkapanpendakian.controller.TransaksiController">
    <children>

        <!-- Judul + tombol tambah -->
        <HBox alignment="CENTER_LEFT">
            <children>
                <Label text="Transaksi"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #00572B;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="tombolTambah" mnemonicParsing="false" onAction="#tambahTransaksi"
                        text="+  |  Tambah Transaksi"
                        style="-fx-background-color: #00572B; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 8; -fx-padding: 8 16 8 16; -fx-cursor: hand;" />
            </children>
        </HBox>

        <!-- Panel putih  -->
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
                    style="-fx-background: white; -fx-background-color: white; -fx-background-radius: 30; -fx-border-radius: 30;">
            <content>
                <VBox fx:id="containerTransaksi" spacing="24.0" style="-fx-background-color: white;">
                    <padding>
                        <Insets bottom="30.0" left="40.0" right="40.0" top="25.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>

    </children>
    <padding>
        <Insets bottom="0.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
