<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="680" prefWidth="1000" spacing="16" style="-fx-background-color: #F0F0F0;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sistemmanajemenpenyewaanperlengkapanpendakian.controller.ProfileController">

    <padding>
        <Insets bottom="8" left="8" right="8" top="8" />
    </padding>

    <Label style="-fx-font-size: 22px;                   -fx-font-weight: bold;                   -fx-text-fill: #00643D;" text="Profile" />

    <VBox spacing="22" style="-fx-background-color: white;                  -fx-background-radius: 14;" VBox.vgrow="ALWAYS">

        <padding>
            <Insets bottom="26" left="30" right="30" top="26" />
        </padding>

        <!-- Foto profil dan tombol -->
        <HBox alignment="CENTER_LEFT" spacing="22">

            <ImageView fx:id="profileImage" fitHeight="112" fitWidth="112" preserveRatio="false" smooth="true" />

            <VBox spacing="12">
                <Label style="-fx-font-size: 18px;                               -fx-font-weight: bold;                               -fx-text-fill: #164D35;" text="Profil Admin" />

                <HBox spacing="10">
                    <Button fx:id="editButton" onAction="#handleEdit" style="-fx-background-color: #00643D;                                    -fx-text-fill: white;                                    -fx-background-radius: 7;                                    -fx-font-weight: bold;                                    -fx-padding: 9 20;                                    -fx-cursor: hand;" text="Edit Profile" />

                    <Button fx:id="uploadButton" managed="false" onAction="#handleUploadPhoto" style="-fx-background-color: white;                                    -fx-text-fill: #00643D;                                    -fx-border-color: #00643D;                                    -fx-border-radius: 7;                                    -fx-background-radius: 7;                                    -fx-padding: 9 18;                                    -fx-cursor: hand;" text="Ganti Foto" visible="false" />
                </HBox>
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <Button fx:id="deleteButton" managed="false" onAction="#handleDelete" style="-fx-background-color: white;                            -fx-text-fill: #B3261E;                            -fx-border-color: #B3261E;                            -fx-border-radius: 7;                            -fx-background-radius: 7;                            -fx-padding: 9 16;                            -fx-cursor: hand;" text="Hapus Foto Profile" visible="false" />
        </HBox>

        <Separator />

        <!-- Informasi toko -->
        <VBox spacing="15">

            <VBox spacing="6">
                <Label style="-fx-font-size: 12px;                               -fx-text-fill: #333333;" text="Nama Toko" />

                <TextField fx:id="storeNameField" editable="false" />
            </VBox>

            <VBox spacing="6">
                <Label style="-fx-font-size: 12px;                               -fx-text-fill: #333333;" text="Email Toko" />

                <TextField fx:id="emailField" editable="false" />
            </VBox>

            <VBox spacing="6">
                <Label style="-fx-font-size: 12px;                               -fx-text-fill: #333333;" text="Lokasi Toko" />

                <TextField fx:id="locationField" editable="false" />
            </VBox>

        </VBox>

        <Region VBox.vgrow="ALWAYS" />

        <!-- Tombol saat mode edit -->
        <HBox alignment="CENTER_RIGHT" spacing="10">

            <Button fx:id="cancelButton" managed="false" onAction="#handleCancel" style="-fx-background-color: white;                            -fx-text-fill: #00643D;                            -fx-border-color: #00643D;                            -fx-border-radius: 7;                            -fx-background-radius: 7;                            -fx-padding: 10 24;                            -fx-cursor: hand;" text="Batal" visible="false" />

            <Button fx:id="saveButton" managed="false" onAction="#handleSave" style="-fx-background-color: #00643D;                            -fx-text-fill: white;                            -fx-background-radius: 7;                            -fx-font-weight: bold;                            -fx-padding: 10 24;                            -fx-cursor: hand;" text="Simpan Perubahan" visible="false" />

        </HBox>

    </VBox>

</VBox>
