<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/13"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sistemmanajemenpenyewaanperlengkapanpendakian.controller.ProfileController"
      spacing="16"
      prefWidth="1000"
      prefHeight="680"
      style="-fx-background-color: #F0F0F0;">

    <padding>
        <Insets top="8" right="8" bottom="8" left="8"/>
    </padding>

    <Label text="Profile"
           style="-fx-font-size: 22px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #00643D;"/>

    <VBox spacing="22"
          VBox.vgrow="ALWAYS"
          style="-fx-background-color: white;
                 -fx-background-radius: 14;">

        <padding>
            <Insets top="26" right="30" bottom="26" left="30"/>
        </padding>

        <!-- Foto profil dan tombol -->
        <HBox spacing="22" alignment="CENTER_LEFT">

            <ImageView fx:id="profileImage"
                       fitWidth="112"
                       fitHeight="112"
                       preserveRatio="false"
                       smooth="true"/>

            <VBox spacing="12">
                <Label text="Profil Admin"
                       style="-fx-font-size: 18px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #164D35;"/>

                <HBox spacing="10">
                    <Button fx:id="editButton"
                            text="Edit Profile"
                            onAction="#handleEdit"
                            style="-fx-background-color: #00643D;
                                   -fx-text-fill: white;
                                   -fx-background-radius: 7;
                                   -fx-font-weight: bold;
                                   -fx-padding: 9 20;
                                   -fx-cursor: hand;"/>

                    <Button fx:id="uploadButton"
                            text="Ganti Foto"
                            onAction="#handleUploadPhoto"
                            style="-fx-background-color: white;
                                   -fx-text-fill: #00643D;
                                   -fx-border-color: #00643D;
                                   -fx-border-radius: 7;
                                   -fx-background-radius: 7;
                                   -fx-padding: 9 18;
                                   -fx-cursor: hand;"/>
                </HBox>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="deleteButton"
                    text="Hapus Profile"
                    onAction="#handleDelete"
                    style="-fx-background-color: white;
                           -fx-text-fill: #B3261E;
                           -fx-border-color: #B3261E;
                           -fx-border-radius: 7;
                           -fx-background-radius: 7;
                           -fx-padding: 9 16;
                           -fx-cursor: hand;"/>
        </HBox>

        <Separator/>

        <!-- Informasi toko -->
        <VBox spacing="15">

            <VBox spacing="6">
                <Label text="Nama Toko"
                       style="-fx-font-size: 12px;
                              -fx-text-fill: #333333;"/>

                <TextField fx:id="storeNameField"
                           text="Toko Penyewaan Pendakian Abadi"
                           editable="false"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Email Toko"
                       style="-fx-font-size: 12px;
                              -fx-text-fill: #333333;"/>

                <TextField fx:id="emailField"
                           text="tokopenyewaanpendakianabadi@gmail.com"
                           editable="false"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Lokasi Toko"
                       style="-fx-font-size: 12px;
                              -fx-text-fill: #333333;"/>

                <TextField fx:id="locationField"
                           text="Jl. Raya Kampus UNUD, Jimbaran, Bali"
                           editable="false"/>
            </VBox>

        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <!-- Tombol saat mode edit -->
        <HBox spacing="10" alignment="CENTER_RIGHT">

            <Button fx:id="cancelButton"
                    text="Batal"
                    visible="false"
                    managed="false"
                    onAction="#handleCancel"
                    style="-fx-background-color: white;
                           -fx-text-fill: #00643D;
                           -fx-border-color: #00643D;
                           -fx-border-radius: 7;
                           -fx-background-radius: 7;
                           -fx-padding: 10 24;
                           -fx-cursor: hand;"/>

            <Button fx:id="saveButton"
                    text="Simpan Perubahan"
                    visible="false"
                    managed="false"
                    onAction="#handleSave"
                    style="-fx-background-color: #00643D;
                           -fx-text-fill: white;
                           -fx-background-radius: 7;
                           -fx-font-weight: bold;
                           -fx-padding: 10 24;
                           -fx-cursor: hand;"/>

        </HBox>

    </VBox>

</VBox>