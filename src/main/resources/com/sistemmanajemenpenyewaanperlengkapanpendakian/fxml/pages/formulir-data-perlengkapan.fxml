<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="16.0"
      fillWidth="true"
      xmlns="http://javafx.com/javafx/13"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sistemmanajemenpenyewaanperlengkapanpendakian.controller.ControllerFormulirDataPerlengkapan">

    <children>

        <!-- HEADER KEMBALI -->
        <HBox alignment="CENTER_LEFT" prefHeight="42.0">
            <children>
                <Button fx:id="btnKembali"
                        mnemonicParsing="false"
                        onAction="#batal"
                        text="&lt;  Data Perlengkapan"
                        style="-fx-background-color: transparent; -fx-text-fill: #00572B; -fx-font-size: 21px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0;" />
            </children>
            <padding>
                <Insets left="8.0" />
            </padding>
        </HBox>

        <!-- KONTEN FORMULIR -->
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: transparent; -fx-background: transparent;"
                    VBox.vgrow="ALWAYS">

            <content>
                <VBox alignment="TOP_CENTER"
                      fillWidth="true"
                      style="-fx-background-color: transparent;">

                    <padding>
                        <Insets bottom="8.0" />
                    </padding>

                    <VBox spacing="17.0"
                          maxWidth="Infinity"
                          style="-fx-background-color: #FFFFFF; -fx-background-radius: 14;">

                        <padding>
                            <Insets top="25.0" right="34.0" bottom="25.0" left="34.0" />
                        </padding>

                        <children>

                            <Label text="FORMULIR TAMBAH PERLENGKAPAN"
                                   maxWidth="Infinity"
                                   alignment="CENTER"
                                   textFill="#00572B">
                                <font>
                                    <Font name="System Bold" size="20.0" />
                                </font>
                            </Label>

                            <!-- NAMA BARANG -->
                            <VBox spacing="6.0">
                                <children>
                                    <Label text="Nama Barang"
                                           style="-fx-font-size: 13px; -fx-text-fill: #222222;" />
                                    <TextField fx:id="fieldNamaBarang"
                                               promptText="Masukkan nama perlengkapan"
                                               prefHeight="37.0"
                                               maxWidth="Infinity"
                                               style="-fx-background-color: #E8E8E8; -fx-background-radius: 8; -fx-border-color: #555555; -fx-border-radius: 8; -fx-border-width: 1.2;" />
                                </children>
                            </VBox>

                            <!-- JENIS PERLENGKAPAN -->
                            <VBox spacing="6.0">
                                <children>
                                    <Label text="Jenis Perlengkapan"
                                           style="-fx-font-size: 13px; -fx-text-fill: #222222;" />
                                    <ComboBox fx:id="comboJenisPerlengkapan"
                                              prefHeight="37.0"
                                              maxWidth="Infinity"
                                              promptText="Pilih jenis perlengkapan"
                                              style="-fx-background-color: #E8E8E8; -fx-background-radius: 8; -fx-border-color: #555555; -fx-border-radius: 8; -fx-border-width: 1.2;" />
                                </children>
                            </VBox>

                            <!-- DETAIL JENIS -->
                            <VBox spacing="6.0">
                                <children>
                                    <Label fx:id="labelDetailJenis"
                                           text="Tipe Tas"
                                           style="-fx-font-size: 13px; -fx-text-fill: #222222;" />
                                    <TextField fx:id="fieldDetailJenis"
                                               promptText="Contoh: Carrier 45 L"
                                               prefHeight="37.0"
                                               maxWidth="Infinity"
                                               style="-fx-background-color: #E8E8E8; -fx-background-radius: 8; -fx-border-color: #555555; -fx-border-radius: 8; -fx-border-width: 1.2;" />
                                </children>
                            </VBox>

                            <!-- HARGA PERLENGKAPAN -->
                            <VBox spacing="6.0">
                                <children>
                                    <Label text="Harga Perlengkapan"
                                           style="-fx-font-size: 13px; -fx-text-fill: #222222;" />
                                    <TextField fx:id="fieldHargaPerlengkapan"
                                               promptText="Masukkan harga perlengkapan"
                                               prefHeight="37.0"
                                               maxWidth="Infinity"
                                               style="-fx-background-color: #E8E8E8; -fx-background-radius: 8; -fx-border-color: #555555; -fx-border-radius: 8; -fx-border-width: 1.2;" />
                                </children>
                            </VBox>

                            <!-- HARGA SEWA HARIAN -->
                            <VBox spacing="6.0">
                                <children>
                                    <Label text="Harga Sewa (Per Hari)"
                                           style="-fx-font-size: 13px; -fx-text-fill: #222222;" />
                                    <TextField fx:id="fieldHargaSewaHarian"
                                               promptText="Masukkan harga sewa per hari"
                                               prefHeight="37.0"
                                               maxWidth="Infinity"
                                               style="-fx-background-color: #E8E8E8; -fx-background-radius: 8; -fx-border-color: #555555; -fx-border-radius: 8; -fx-border-width: 1.2;" />
                                </children>
                            </VBox>

                            <!-- STOK -->
                            <VBox spacing="6.0">
                                <children>
                                    <Label text="Total Stok"
                                           style="-fx-font-size: 13px; -fx-text-fill: #222222;" />
                                    <TextField fx:id="fieldStok"
                                               promptText="Masukkan jumlah stok"
                                               prefHeight="37.0"
                                               maxWidth="Infinity"
                                               style="-fx-background-color: #E8E8E8; -fx-background-radius: 8; -fx-border-color: #555555; -fx-border-radius: 8; -fx-border-width: 1.2;" />
                                </children>
                            </VBox>

                            <!-- FOTO BARANG -->
                            <VBox spacing="6.0">
                                <children>
                                    <Label text="Foto Barang"
                                           style="-fx-font-size: 13px; -fx-text-fill: #222222;" />

                                    <StackPane prefHeight="112.0"
                                               minHeight="112.0"
                                               maxHeight="112.0"
                                               style="-fx-background-color: #E8E8E8; -fx-background-radius: 8; -fx-border-color: #555555; -fx-border-radius: 8; -fx-border-width: 1.2;">
                                        <children>
                                            <Button fx:id="btnPilihFoto"
                                                    mnemonicParsing="false"
                                                    onAction="#pilihFoto"
                                                    text="☁  ⇧&#10;Pilih Foto Barang"
                                                    maxWidth="Infinity"
                                                    maxHeight="Infinity"
                                                    style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-font-size: 15px; -fx-cursor: hand;" />

                                            <ImageView fx:id="imagePreviewFoto"
                                                       fitWidth="180.0"
                                                       fitHeight="100.0"
                                                       preserveRatio="true"
                                                       mouseTransparent="true" />
                                        </children>
                                    </StackPane>

                                    <Label fx:id="labelFoto"
                                           text="Belum ada foto dipilih"
                                           style="-fx-font-size: 11px; -fx-text-fill: #777777;" />
                                </children>
                            </VBox>

                            <!-- TOMBOL FORMULIR -->
                            <HBox alignment="CENTER_RIGHT" spacing="14.0">
                                <padding>
                                    <Insets top="8.0" />
                                </padding>
                                <children>
                                    <Button fx:id="btnBatalkan"
                                            mnemonicParsing="false"
                                            onAction="#batal"
                                            text="Batalkan"
                                            prefWidth="150.0"
                                            prefHeight="36.0"
                                            style="-fx-background-color: white; -fx-text-fill: #00572B; -fx-border-color: #00572B; -fx-border-radius: 7; -fx-background-radius: 7; -fx-cursor: hand;" />

                                    <Button fx:id="btnKonfirmasi"
                                            mnemonicParsing="false"
                                            onAction="#konfirmasiTambah"
                                            text="Konfirmasi"
                                            prefWidth="150.0"
                                            prefHeight="36.0"
                                            style="-fx-background-color: #00572B; -fx-text-fill: white; -fx-background-radius: 7; -fx-cursor: hand;" />
                                </children>
                            </HBox>

                        </children>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</VBox>
