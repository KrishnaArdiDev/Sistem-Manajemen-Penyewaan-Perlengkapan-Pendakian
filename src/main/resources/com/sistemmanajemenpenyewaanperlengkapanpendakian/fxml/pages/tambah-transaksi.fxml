<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sistemmanajemenpenyewaanperlengkapanpendakian.controller.TambahTransaksiController">
    <children>

        <!-- Judul + tombol kembali -->
        <Button mnemonicParsing="false" onAction="#batal" style="-fx-background-color: transparent; -fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #00572B; -fx-cursor: hand; -fx-padding: 0;" text="&lt;  Transaksi" />

        <!-- Panel putih -->
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: white; -fx-background-color: white; -fx-background-radius: 30;" VBox.vgrow="ALWAYS">
            <content>
                <VBox spacing="6.0" style="-fx-background-color: white;">
                    <padding>
                        <Insets bottom="30.0" left="50.0" right="50.0" top="30.0" />
                    </padding>
                    <children>

                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #00572B;" text="Data Penyewa" />

                        <!-- Nama Peminjam -->
                        <Label style="-fx-font-size: 14px; -fx-padding: 10 0 0 0;" text="Nama Penyewa" />
                        <TextField fx:id="fieldNama" prefHeight="36.0" style="-fx-background-color: #E8E8E8; -fx-border-color: #3A3A3A; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8;" />
                        <HBox alignment="CENTER_LEFT" prefHeight="36.0" spacing="10.0" style="-fx-background-color: #E8E8E8; -fx-border-color: #3A3A3A; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 4 0 10;">
                            <children>
                                <Label fx:id="labelFoto" maxWidth="Infinity" style="-fx-text-fill: #7A7A7A;" text="Belum ada file dipilih" HBox.hgrow="ALWAYS" />
                                <Button mnemonicParsing="false" onAction="#pilihFoto" style="-fx-background-color: #00572B; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;" text="Pilih File" />
                            </children>
                        </HBox>

                        <!-- Foto Identitas -->
                        <Label style="-fx-font-size: 14px; -fx-padding: 10 0 0 0;" text="Foto Identitas" />

                        <!-- Barang Pinjaman -->
                        <Label style="-fx-font-size: 14px; -fx-padding: 10 0 0 0;" text="Barang Sewaan" />
                        <HBox spacing="10.0">
                            <children>
                                <ComboBox fx:id="comboPerlengkapan" maxWidth="Infinity" prefHeight="36.0" promptText="Pilih barang" style="-fx-background-color: #E8E8E8; -fx-border-color: #3A3A3A; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8;" HBox.hgrow="ALWAYS" />
                                <Spinner fx:id="spinnerJumlah" editable="true" prefHeight="36.0" prefWidth="100.0" />
                            </children>
                        </HBox>

                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #00572B;" text="Perlengkapan yang Disewa" />

                        <!-- Tanggal Kembali -->
                        <Label style="-fx-font-size: 14px; -fx-padding: 10 0 0 0;" text="Tanggal Kembali" />
                        <DatePicker fx:id="dateKembali" maxWidth="Infinity" prefHeight="36.0" style="-fx-background-color: #E8E8E8; -fx-border-color: #3A3A3A; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8;" />

                        <!-- Total Harga -->
                        <Label style="-fx-font-size: 14px; -fx-padding: 10 0 0 0;" text="Total Harga" />
                        <Label fx:id="labelTotal" maxWidth="Infinity" prefHeight="36.0" style="-fx-background-color: #E8E8E8; -fx-border-color: #3A3A3A; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 10 0 10; -fx-font-weight: bold; -fx-text-fill: #00572B;" text="Rp 0" />

                        <!-- Tombol aksi -->
                        <HBox alignment="CENTER_RIGHT" spacing="16.0">
                            <VBox.margin>
                                <Insets top="24.0" />
                            </VBox.margin>
                            <children>
                                <Button fx:id="tombolBatal" mnemonicParsing="false" onAction="#batal" prefWidth="160.0" style="-fx-background-color: white; -fx-text-fill: #00572B; -fx-border-color: #00572B; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 8 0 8 0; -fx-cursor: hand;" text="Batalkan" />
                                <Button fx:id="tombolSimpan" mnemonicParsing="false" onAction="#simpan" prefWidth="160.0" style="-fx-background-color: #00572B; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 8 0 8 0; -fx-cursor: hand;" text="Konfirmasi" />
                            </children>
                        </HBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>

    </children>
    <padding>
        <Insets left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
