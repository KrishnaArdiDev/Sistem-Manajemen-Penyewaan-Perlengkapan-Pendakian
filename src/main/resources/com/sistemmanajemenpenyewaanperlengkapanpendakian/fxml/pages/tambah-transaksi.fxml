<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- ROOT FORM TAMBAH TRANSAKSI -->
<ScrollPane fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            style="-fx-background-color: transparent; -fx-background: transparent;"
            xmlns="http://javafx.com/javafx/13"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sistemmanajemenpenyewaanperlengkapanpendakian.controller.TambahTransaksiController">

    <content>
        <VBox spacing="16.0" fillWidth="true">

            <padding>
                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>

            <!-- TOMBOL KEMBALI -->
            <Button mnemonicParsing="false"
                    onAction="#batal"
                    text="&lt;  Transaksi"
                    maxWidth="Infinity"
                    alignment="CENTER_LEFT"
                    style="-fx-background-color: transparent; -fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #00572B; -fx-cursor: hand; -fx-padding: 0;"/>

            <!-- KARTU FORMULIR -->
            <VBox spacing="16.0"
                  maxWidth="Infinity"
                  style="-fx-background-color: white; -fx-background-radius: 14;">

                <padding>
                    <Insets top="24.0" right="28.0" bottom="24.0" left="28.0"/>
                </padding>

                <!-- JUDUL -->
                <Label text="FORMULIR TAMBAH TRANSAKSI"
                       maxWidth="Infinity"
                       alignment="CENTER"
                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #00572B;"/>

                <!-- NAMA PENYEWA -->
                <VBox spacing="6.0">

                    <Label text="Nama Penyewa"
                           style="-fx-font-size: 14px; -fx-text-fill: #222222;"/>

                    <TextField fx:id="fieldNama"
                               promptText="Masukkan nama penyewa"
                               prefHeight="36.0"
                               maxWidth="Infinity"
                               style="-fx-background-color: #E8E8E8; -fx-border-color: #3A3A3A; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8;"/>

                </VBox>

                <!-- TAMBAHAN: NOMOR IDENTITAS SESUAI MODEL PELANGGAN -->
                <VBox spacing="6.0">

                    <Label text="Nomor Identitas"
                           style="-fx-font-size: 14px; -fx-text-fill: #222222;"/>

                    <TextField fx:id="fieldNoIdentitas"
                               promptText="Masukkan nomor KTP/identitas"
                               prefHeight="36.0"
                               maxWidth="Infinity"
                               style="-fx-background-color: #E8E8E8; -fx-border-color: #3A3A3A; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8;"/>

                </VBox>

                <!-- FOTO IDENTITAS -->
                <VBox spacing="6.0">

                    <Label text="Foto Identitas"
                           style="-fx-font-size: 14px; -fx-text-fill: #222222;"/>

                    <HBox spacing="10.0"
                          alignment="CENTER_LEFT"
                          minHeight="40.0"
                          prefHeight="40.0"
                          style="-fx-background-color: #E8E8E8; -fx-border-color: #3A3A3A; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 4 0 10;">

                        <Label fx:id="labelFoto"
                               text="Belum ada file dipilih"
                               maxWidth="Infinity"
                               HBox.hgrow="ALWAYS"
                               style="-fx-text-fill: #7A7A7A;"/>

                        <Button mnemonicParsing="false"
                                onAction="#pilihFoto"
                                text="Pilih File"
                                style="-fx-background-color: #00572B; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand;"/>

                    </HBox>

                </VBox>

                <!-- PEMILIHAN PERLENGKAPAN -->
                <Label text="Perlengkapan yang Disewa"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #00572B;"/>

                <Button fx:id="btnBukaDaftarPerlengkapan"
                        mnemonicParsing="false"
                        onAction="#toggleDaftarPerlengkapan"
                        text="Pilih Barang Sewa (0)"
                        alignment="CENTER_LEFT"
                        maxWidth="Infinity"
                        prefHeight="38.0"
                        style="-fx-background-color: #E8E8E8; -fx-border-color: #3A3A3A; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #333333; -fx-cursor: hand;"/>

                <!-- DAFTAR BARANG DIISI OLEH CONTROLLER -->
                <ScrollPane fx:id="scrollDaftarPerlengkapan"
                            fitToWidth="true"
                            hbarPolicy="NEVER"
                            vbarPolicy="AS_NEEDED"
                            prefViewportHeight="190.0"
                            minHeight="100.0"
                            maxHeight="230.0"
                            visible="false"
                            managed="false"
                            style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: #CFCFCF; -fx-border-radius: 8; -fx-background-radius: 8;">

                    <content>
                        <VBox fx:id="containerDaftarPerlengkapan"
                              spacing="8.0"
                              fillWidth="true"
                              style="-fx-background-color: white;">

                            <padding>
                                <Insets top="6.0" right="6.0" bottom="6.0" left="6.0"/>
                            </padding>

                        </VBox>
                    </content>

                </ScrollPane>

                <!-- TANGGAL MENYEWA -->
                <VBox spacing="6.0">

                    <Label text="Tanggal Menyewa"
                           style="-fx-font-size: 14px; -fx-text-fill: #222222;"/>

                    <DatePicker fx:id="dateSewa"
                                maxWidth="Infinity"
                                prefHeight="36.0"
                                promptText="Pilih tanggal menyewa"
                                style="-fx-background-color: #E8E8E8; -fx-border-color: #3A3A3A; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8;"/>

                </VBox>

                <!-- TANGGAL KEMBALI -->
                <VBox spacing="6.0">

                    <Label text="Tanggal Kembali"
                           style="-fx-font-size: 14px; -fx-text-fill: #222222;"/>

                    <DatePicker fx:id="dateKembali"
                                maxWidth="Infinity"
                                prefHeight="36.0"
                                promptText="Pilih tanggal kembali"
                                style="-fx-background-color: #E8E8E8; -fx-border-color: #3A3A3A; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8;"/>

                </VBox>

                <!-- TAMBAHAN: METODE PEMBAYARAN SESUAI MODEL TRANSAKSI -->
                <VBox spacing="6.0">

                    <Label text="Metode Pembayaran"
                           style="-fx-font-size: 14px; -fx-text-fill: #222222;"/>

                    <ComboBox fx:id="comboMetodePembayaran"
                              maxWidth="Infinity"
                              prefHeight="36.0"
                              promptText="Pilih metode pembayaran"
                              style="-fx-background-color: #E8E8E8; -fx-border-color: #3A3A3A; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8;"/>

                </VBox>

                <!-- TOTAL HARGA -->
                <VBox spacing="6.0">

                    <Label text="Total Harga"
                           style="-fx-font-size: 14px; -fx-text-fill: #222222;"/>

                    <Label fx:id="labelTotal"
                           text="Rp 0"
                           maxWidth="Infinity"
                           minHeight="40.0"
                           alignment="CENTER_LEFT"
                           style="-fx-background-color: #E8E8E8; -fx-border-color: #3A3A3A; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 10 0 10; -fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #00572B;"/>

                </VBox>

                <!-- TOMBOL AKSI -->
                <HBox alignment="CENTER_RIGHT" spacing="16.0">

                    <padding>
                        <Insets top="14.0"/>
                    </padding>

                    <Button fx:id="tombolBatal"
                            mnemonicParsing="false"
                            onAction="#batal"
                            text="Batalkan"
                            prefWidth="160.0"
                            prefHeight="36.0"
                            style="-fx-background-color: white; -fx-text-fill: #00572B; -fx-border-color: #00572B; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;"/>

                    <Button fx:id="tombolSimpan"
                            mnemonicParsing="false"
                            onAction="#simpan"
                            text="Konfirmasi"
                            prefWidth="160.0"
                            prefHeight="36.0"
                            style="-fx-background-color: #00572B; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;"/>

                </HBox>

            </VBox>
        </VBox>
    </content>
</ScrollPane>
