<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Form Tambah Transaksi (dipakai sebagai popup dari halaman Transaksi) -->
<VBox spacing="16.0" prefWidth="760.0" style="-fx-background-color: #F0F0F0;"
      xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sistemmanajemenpenyewaanperlengkapanpendakian.controller.TambahTransaksiController">
    <children>

        <!-- Judul -->
        <Label text="Tambah Transaksi"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #00572B;" />

        <!-- Kartu putih -->
        <VBox spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 14;">
            <padding>
                <Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
            </padding>
            <children>

                <!-- ===== Data penyewa & tanggal ===== -->
                <Label text="Data Penyewa"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #00572B;" />

                <GridPane hgap="20.0" vgap="14.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                    </columnConstraints>
                    <children>
                        <!-- Baris 0 -->
                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <children>
                                <Label text="Nama Penyewa" style="-fx-text-fill: #7A7A7A; -fx-font-size: 13px;" />
                                <TextField fx:id="fieldNama" promptText="Masukkan nama penyewa"
                                           style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #CFCFCF;" />
                            </children>
                        </VBox>
                        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <children>
                                <Label text="No. Telepon" style="-fx-text-fill: #7A7A7A; -fx-font-size: 13px;" />
                                <TextField fx:id="fieldTelepon" promptText="08xxxxxxxxxx"
                                           style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #CFCFCF;" />
                            </children>
                        </VBox>

                        <!-- Baris 1 -->
                        <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <children>
                                <Label text="Tanggal Sewa" style="-fx-text-fill: #7A7A7A; -fx-font-size: 13px;" />
                                <DatePicker fx:id="dateSewa" maxWidth="Infinity"
                                            style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #CFCFCF;" />
                            </children>
                        </VBox>
                        <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <children>
                                <Label text="Tanggal Kembali" style="-fx-text-fill: #7A7A7A; -fx-font-size: 13px;" />
                                <DatePicker fx:id="dateKembali" maxWidth="Infinity"
                                            style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #CFCFCF;" />
                            </children>
                        </VBox>
                    </children>
                </GridPane>

                <!-- ===== Perlengkapan ===== -->
                <Label text="Perlengkapan yang Disewa"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #00572B;" />

                <HBox alignment="BOTTOM_LEFT" spacing="12.0">
                    <children>
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Perlengkapan" style="-fx-text-fill: #7A7A7A; -fx-font-size: 13px;" />
                                <ComboBox fx:id="comboPerlengkapan" maxWidth="Infinity"
                                          promptText="Pilih perlengkapan"
                                          style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #CFCFCF;" />
                            </children>
                        </VBox>
                        <VBox spacing="6.0">
                            <children>
                                <Label text="Jumlah" style="-fx-text-fill: #7A7A7A; -fx-font-size: 13px;" />
                                <Spinner fx:id="spinnerJumlah" editable="true" prefWidth="100.0" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label text="Total:  " style="-fx-font-size: 16px; -fx-text-fill: #7A7A7A;" />
                        <Label fx:id="labelTotal" text="Rp 0"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #00572B;" />
                    </children>
                </HBox>

            </children>
        </VBox>

        <!-- Tombol aksi -->
        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <children>
                <Button fx:id="tombolBatal" mnemonicParsing="false" onAction="#batal" text="Batal"
                        style="-fx-background-color: white; -fx-text-fill: #00572B; -fx-border-color: #00572B; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 8 24 8 24; -fx-cursor: hand;" />
                <Button fx:id="tombolSimpan" mnemonicParsing="false" onAction="#simpan" text="Simpan Transaksi"
                        style="-fx-background-color: #00572B; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 8; -fx-padding: 8 24 8 24; -fx-cursor: hand;" />
            </children>
        </HBox>

    </children>
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
    </padding>
</VBox>
