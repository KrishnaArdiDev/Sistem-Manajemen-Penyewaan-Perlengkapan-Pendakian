<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.ColumnConstraints?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sistemmanajemenpenyewaanperlengkapanpendakian.controller.RingkasanTransaksiController"
            fx:id="rootRingkasan"
            prefWidth="850"
            prefHeight="570"
            style="-fx-background-color: #F8FAFC;">

    <center>
        <VBox spacing="22" style="-fx-background-color: #F8FAFC;">
            <padding>
                <Insets top="35" right="40" bottom="25" left="40"/>
            </padding>

            <!-- HEADER -->
            <HBox spacing="18" alignment="CENTER_LEFT">
                <Label text="✓"
                       style="-fx-background-color: #13865C;
                              -fx-text-fill: white;
                              -fx-font-size: 32px;
                              -fx-font-weight: bold;
                              -fx-background-radius: 50%;
                              -fx-min-width: 75px;
                              -fx-min-height: 75px;
                              -fx-alignment: CENTER;"/>

                <VBox spacing="6">
                    <Label text="Ringkasan Transaksi"
                           style="-fx-font-size: 27px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #172B3A;"/>

                    <Label text="Berikut adalah detail transaksi Anda"
                           style="-fx-font-size: 15px;
                                  -fx-text-fill: #64748B;"/>
                </VBox>
            </HBox>

            <Separator style="-fx-background-color: #13865C;"/>

            <!-- DETAIL TRANSAKSI -->
            <VBox spacing="18"
                  style="-fx-background-color: white;
                         -fx-background-radius: 12;
                         -fx-border-color: #E2E8F0;
                         -fx-border-radius: 12;">
                <padding>
                    <Insets top="25" right="28" bottom="25" left="28"/>
                </padding>

                <GridPane hgap="20" vgap="22">

                    <columnConstraints>
                        <ColumnConstraints minWidth="180"/>
                        <ColumnConstraints minWidth="15"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="ID Transaksi"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="0"
                           style="-fx-font-size: 15px; -fx-text-fill: #64748B;"/>

                    <Label text=":"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="1"/>

                    <Label fx:id="lblIdTransaksi"
                           text="TRX-001"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="2"
                           style="-fx-font-size: 15px; -fx-text-fill: #172B3A;"/>

                    <Label text="Nama Penyewa"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="0"
                           style="-fx-font-size: 15px; -fx-text-fill: #64748B;"/>

                    <Label text=":"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="1"/>

                    <Label fx:id="lblNamaPenyewa"
                           text="Andi Wijaya"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="2"
                           style="-fx-font-size: 15px; -fx-text-fill: #172B3A;"/>

                    <Label text="Tanggal Transaksi"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="0"
                           style="-fx-font-size: 15px; -fx-text-fill: #64748B;"/>

                    <Label text=":"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="1"/>

                    <Label fx:id="lblTanggalTransaksi"
                           text="22 November 2026"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="2"
                           style="-fx-font-size: 15px; -fx-text-fill: #172B3A;"/>

                    <Label text="Perlengkapan"
                           GridPane.rowIndex="3"
                           GridPane.columnIndex="0"
                           style="-fx-font-size: 15px; -fx-text-fill: #64748B;"/>

                    <Label text=":"
                           GridPane.rowIndex="3"
                           GridPane.columnIndex="1"/>

                    <Label fx:id="lblPerlengkapan"
                           text="Tas Carrier Puma"
                           GridPane.rowIndex="3"
                           GridPane.columnIndex="2"
                           style="-fx-font-size: 15px; -fx-text-fill: #172B3A;"/>

                    <Label text="Jumlah"
                           GridPane.rowIndex="4"
                           GridPane.columnIndex="0"
                           style="-fx-font-size: 15px; -fx-text-fill: #64748B;"/>

                    <Label text=":"
                           GridPane.rowIndex="4"
                           GridPane.columnIndex="1"/>

                    <Label fx:id="lblJumlah"
                           text="1 Unit"
                           GridPane.rowIndex="4"
                           GridPane.columnIndex="2"
                           style="-fx-font-size: 15px; -fx-text-fill: #172B3A;"/>

                </GridPane>

                <Separator/>

                <!-- TOTAL BIAYA -->
                <HBox alignment="CENTER_LEFT">
                    <Label text="Total Biaya"
                           style="-fx-font-size: 19px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #172B3A;"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label fx:id="lblTotalBiaya"
                           text="Rp 50.000"
                           style="-fx-font-size: 23px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #13865C;"/>
                </HBox>
            </VBox>

        </VBox>
    </center>

    <!-- FOOTER BUTTON -->
    <bottom>
        <HBox spacing="15"
              alignment="CENTER_RIGHT"
              style="-fx-background-color: white;">
            <padding>
                <Insets top="20" right="40" bottom="25" left="40"/>
            </padding>

            <Button text="Cetak"
                    fx:id="btnCetak"
                    onAction="#Cetak"
                    prefWidth="130"
                    prefHeight="42"
                    style="-fx-background-color: white;
                           -fx-border-color: #13865C;
                           -fx-border-radius: 7;
                           -fx-background-radius: 7;
                           -fx-text-fill: #13865C;
                           -fx-font-size: 15px;
                           -fx-font-weight: bold;"/>

            <Button text="Tutup"
                    fx:id="btnTutup"
                    onAction="#Tutup"
                    prefWidth="130"
                    prefHeight="42"
                    style="-fx-background-color: #13865C;
                           -fx-background-radius: 7;
                           -fx-text-fill: white;
                           -fx-font-size: 15px;
                           -fx-font-weight: bold;"/>
        </HBox>
    </bottom>

</BorderPane>
