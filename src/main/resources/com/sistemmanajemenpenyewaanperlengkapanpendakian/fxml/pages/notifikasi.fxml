<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="rootNotifikasi"
      spacing="14.0"
      fillWidth="true"
      prefWidth="1149.0"
      prefHeight="909.0"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sistemmanajemenpenyewaanperlengkapanpendakian.controller.NotifikasiController">

    <padding>
        <Insets top="20.0"
                right="20.0"
                bottom="20.0"
                left="20.0"/>
    </padding>

    <Label text="Notifikasi"
           style="-fx-font-size: 24px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #00572B;"/>

    <ScrollPane fx:id="scrollDaftarNotifikasi"
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent;
                       -fx-background: transparent;">

        <content>

            <VBox fx:id="containerNotifikasi"
                  spacing="12.0"
                  fillWidth="true"
                  style="-fx-background-color: #FFFFFF;
                         -fx-background-radius: 16;">

                <padding>
                    <Insets top="24.0"
                            right="40.0"
                            bottom="24.0"
                            left="40.0"/>
                </padding>

            </VBox>

        </content>

    </ScrollPane>

    <HBox fx:id="containerPagination"
          alignment="CENTER"
          spacing="8.0"
          minHeight="38.0"
          prefHeight="38.0"/>

</VBox>