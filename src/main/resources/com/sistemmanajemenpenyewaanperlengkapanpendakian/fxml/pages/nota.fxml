<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- PERUBAHAN: CONTROLLER MENGGUNAKAN NotaController -->
<VBox spacing="16.0"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sistemmanajemenpenyewaanperlengkapanpendakian.controller.NotaController">

    <children>

        <!-- JUDUL DAN NAVIGASI -->
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <children>

                <Label onMouseClicked="#kembali"
                       text="‹"
                       style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #00572B; -fx-cursor: hand;"/>

                <Label fx:id="labelJudulDokumen"
       text="Nota Transaksi"
       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #00572B;"/>

            </children>
        </HBox>

        <!-- AREA NOTA -->
        <ScrollPane fx:id="scrollPreview"
               fitToWidth="true"
                    hbarPolicy="NEVER"
                    VBox.vgrow="ALWAYS"
                    style="-fx-background: white; -fx-background-color: white; -fx-background-radius: 30; -fx-border-radius: 30;">

            <content>

                <VBox fx:id="kertasNota"
                      spacing="18.0"
                      style="-fx-background-color: white;">

                    <padding>
                        <Insets bottom="30.0" left="40.0" right="40.0" top="25.0"/>
                    </padding>

                    <children>

                        <!-- HEADER NOTA -->
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>

                                <ImageView fitHeight="54.0"
                                           fitWidth="56.0"
                                           pickOnBounds="true"
                                           preserveRatio="true">
                                    <image>
                                        <!-- PERUBAHAN: PATH LOGO -->
                                        <Image url="@../../../../images/Logo.png"/>
                                    </image>
                                </ImageView>

                                <VBox alignment="CENTER_LEFT" spacing="2.0">
                                    <children>

                                        <Label text="TAPAK"
                                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #00572B;"/>

                                        <Label text="Penyewaan Perlengkapan Pendakian"
                                               style="-fx-font-size: 13px; -fx-text-fill: #7A7A7A;"/>

                                    </children>
                                </VBox>

                                <Region HBox.hgrow="ALWAYS"/>

                                <VBox alignment="CENTER_RIGHT" spacing="2.0">
                                    <children>

                                        <Label text="NOTA PENYEWAAN"
                                               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: black;"/>

                                        <Label fx:id="labelTanggalCetak"
                                               text="Dicetak: 00-00-0000"
                                               style="-fx-font-size: 13px; -fx-text-fill: #7A7A7A;"/>

                                    </children>
                                </VBox>

                            </children>
                        </HBox>

                        <Separator/>

                        <!-- INFORMASI TRANSAKSI -->
                        <GridPane hgap="24.0" vgap="8.0">

                            <columnConstraints>
                                <ColumnConstraints minWidth="150.0"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>

                            <children>

                                <Label text="ID Transaksi"
                                       GridPane.rowIndex="0"
                                       style="-fx-font-size: 14px; -fx-text-fill: #7A7A7A;"/>

                                <Label fx:id="labelIdTransaksi"
                                       text="-"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="0"
                                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: black;"/>

                                <Label text="Tanggal Transaksi"
                                       GridPane.rowIndex="1"
                                       style="-fx-font-size: 14px; -fx-text-fill: #7A7A7A;"/>

                                <Label fx:id="labelTanggalTransaksi"
                                       text="-"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="1"
                                       style="-fx-font-size: 14px; -fx-text-fill: black;"/>

                                <Label text="Nama Penyewa"
                                       GridPane.rowIndex="2"
                                       style="-fx-font-size: 14px; -fx-text-fill: #7A7A7A;"/>

                                <Label fx:id="labelPenyewa"
                                       text="-"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="2"
                                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: black;"/>

                                <Label text="Tanggal Sewa"
                                       GridPane.rowIndex="3"
                                       style="-fx-font-size: 14px; -fx-text-fill: #7A7A7A;"/>

                                <Label fx:id="labelTglSewa"
                                       text="-"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="3"
                                       style="-fx-font-size: 14px; -fx-text-fill: black;"/>

                                <Label text="Tanggal Kembali"
                                       GridPane.rowIndex="4"
                                       style="-fx-font-size: 14px; -fx-text-fill: #7A7A7A;"/>

                                <Label fx:id="labelTglKembali"
                                       text="-"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="4"
                                       style="-fx-font-size: 14px; -fx-text-fill: black;"/>

                                <Label text="Metode Pembayaran"
                                       GridPane.rowIndex="5"
                                       style="-fx-font-size: 14px; -fx-text-fill: #7A7A7A;"/>

                                <Label fx:id="labelMetodePembayaran"
                                       text="-"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="5"
                                       style="-fx-font-size: 14px; -fx-text-fill: black;"/>

                                <Label text="Status"
                                       GridPane.rowIndex="6"
                                       style="-fx-font-size: 14px; -fx-text-fill: #7A7A7A;"/>

                                <Label fx:id="labelStatus"
                                       text="-"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="6"
                                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #00572B;"/>

                            </children>
                        </GridPane>

                        <!-- TABEL DETAIL BARANG -->
                        <!-- PERUBAHAN: BARIS TABEL AKAN DIISI DINAMIS OLEH CONTROLLER -->
                        <GridPane fx:id="gridDetailBarang"
                                  hgap="12.0"
                                  vgap="0.0">

                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="36.0"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="12.0"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="14.0"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="18.0"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="20.0"/>
                            </columnConstraints>

                            <children>

                                <Label maxWidth="Infinity"
                                       text="Barang"
                                       GridPane.columnIndex="0"
                                       GridPane.rowIndex="0"
                                       style="-fx-background-color: #00572B; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 8 10 8 10; -fx-background-radius: 8 0 0 0;"/>

                                <Label maxWidth="Infinity"
                                       text="Jumlah"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="0"
                                       style="-fx-background-color: #00572B; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 8 10 8 10;"/>

                                <Label maxWidth="Infinity"
                                       text="Lama Sewa"
                                       GridPane.columnIndex="2"
                                       GridPane.rowIndex="0"
                                       style="-fx-background-color: #00572B; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 8 10 8 10;"/>

                                <Label maxWidth="Infinity"
                                       text="Harga / Hari"
                                       GridPane.columnIndex="3"
                                       GridPane.rowIndex="0"
                                       style="-fx-background-color: #00572B; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 8 10 8 10;"/>

                                <Label maxWidth="Infinity"
                                       text="Subtotal"
                                       GridPane.columnIndex="4"
                                       GridPane.rowIndex="0"
                                       style="-fx-background-color: #00572B; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 8 10 8 10; -fx-background-radius: 0 8 0 0;"/>

                            </children>
                        </GridPane>

                        <!-- TOTAL KUANTITAS -->
                        <HBox alignment="CENTER_RIGHT" spacing="12.0">
                            <children>

                                <Label text="Total Kuantitas"
                                       style="-fx-font-size: 14px; -fx-text-fill: #7A7A7A;"/>

                                <Label fx:id="labelTotalKuantitas"
                                       text="0"
                                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: black;"/>

                            </children>
                        </HBox>

                        <!-- TAGIHAN PENGEMBALIAN -->
                        <!-- HANYA MUNCUL JIKA SUDAH ADA PENGEMBALIAN -->
                        <VBox fx:id="containerTagihanPengembalian"
                              visible="false"
                              managed="false"
                              spacing="8.0"
                              style="-fx-background-color: #FFF8E8; -fx-background-radius: 8;">

                            <padding>
                                <Insets top="12.0" right="14.0" bottom="12.0" left="14.0"/>
                            </padding>

                            <children>

                                <Label text="TAGIHAN SAAT PENGEMBALIAN"
                                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #805B00;"/>

                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label text="Denda Keterlambatan"
                                               style="-fx-text-fill: #555555;"/>

                                        <Region HBox.hgrow="ALWAYS"/>

                                        <Label fx:id="labelDenda"
                                               text="Rp 0"
                                               style="-fx-font-weight: bold; -fx-text-fill: #222222;"/>
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label text="Biaya Ganti Rugi"
                                               style="-fx-text-fill: #555555;"/>

                                        <Region HBox.hgrow="ALWAYS"/>

                                        <Label fx:id="labelGantiRugi"
                                               text="Rp 0"
                                               style="-fx-font-weight: bold; -fx-text-fill: #222222;"/>
                                    </children>
                                </HBox>

                                <Separator/>

                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label text="Total Tagihan Pengembalian"
                                               style="-fx-font-weight: bold; -fx-text-fill: #805B00;"/>

                                        <Region HBox.hgrow="ALWAYS"/>

                                        <Label fx:id="labelTotalTagihanPengembalian"
                                               text="Rp 0"
                                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #805B00;"/>
                                    </children>
                                </HBox>

                            </children>
                        </VBox>

                        <!-- TOTAL BIAYA SEWA -->
                        <HBox alignment="CENTER_RIGHT" spacing="16.0">
                            <children>

                                <Label text="Total Biaya Sewa"
                                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: black;"/>

                                <Label fx:id="labelTotal"
                                       text="Rp 0"
                                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #00572B;"/>

                            </children>
                        </HBox>

                        <Separator/>

                        <Label text="Terima kasih telah menyewa di TAPAK. Harap kembalikan perlengkapan sesuai tanggal kembali."
                               wrapText="true"
                               style="-fx-font-size: 13px; -fx-text-fill: #7A7A7A;"/>

                        <!-- FOTO IDENTITAS -->
                        <VBox alignment="TOP_CENTER" spacing="6.0">
                            <children>

                                <Label text="Foto Identitas"
                                       style="-fx-font-size: 13px; -fx-text-fill: #7A7A7A;"/>

                                <ImageView fx:id="imageFotoIdentitas"
                                           fitHeight="120.0"
                                           fitWidth="190.0"
                                           pickOnBounds="true"
                                           preserveRatio="true"/>

                                <Label fx:id="labelFotoKosong"
                                       text="Tidak ada foto"
                                       alignment="CENTER"
                                       prefHeight="120.0"
                                       prefWidth="190.0"
                                       style="-fx-background-color: #E8E8E8; -fx-background-radius: 8; -fx-text-fill: #7A7A7A;"/>

                            </children>
                        </VBox>

                    </children>
                </VBox>

            </content>
        </ScrollPane>

        <!-- TOMBOL AKSI -->
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>

                <Button fx:id="btnCetakDokumen"
                        mnemonicParsing="false"
                        onAction="#cetakDokumen"
                        text="Cetak Dokumen"
                        style="-fx-background-color: #00572B; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 8 16 8 16; -fx-cursor: hand;"/>

                <Button fx:id="tombolKembali"
                        mnemonicParsing="false"
                        onAction="#kembali"
                        text="Kembali"
                        style="-fx-background-color: white; -fx-text-fill: #00572B; -fx-border-color: #00572B; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8 16 8 16; -fx-cursor: hand;"/>

            </children>
        </HBox>

    </children>

    <padding>
        <Insets bottom="16.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
</VBox>
