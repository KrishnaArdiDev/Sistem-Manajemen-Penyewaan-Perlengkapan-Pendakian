<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sistemmanajemenpenyewaanperlengkapanpendakian.controller.ProfileController"
      spacing="18"
      style="-fx-background-color: #f3f4f3;"
      prefWidth="900" prefHeight="650">

    <padding>
        <Insets top="25" right="30" bottom="25" left="30"/>
    </padding>

    <Label text="Profile"
           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #00643d;"/>

    <VBox spacing="22"
          style="-fx-background-color: white; -fx-background-radius: 16;"
          VBox.vgrow="ALWAYS">

        <padding>
            <Insets top="28" right="32" bottom="28" left="32"/>
        </padding>

        <HBox spacing="22" alignment="CENTER_LEFT">
            <ImageView fx:id="profileImage"
                       fitWidth="112" fitHeight="112"
                       preserveRatio="false"
                       style="-fx-effect: dropshadow(gaussian, #cccccc, 8, 0.2, 0, 2);"/>

            <VBox spacing="12">
                <Label text="Profil Admin"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #164d35;"/>

                <HBox spacing="10">
                    <Button fx:id="editButton"
                            text="Edit Profile"
                            onAction="#handleEdit"
                            style="-fx-background-color: #00643d; -fx-text-fill: white; -fx-background-radius: 7; -fx-font-weight: bold; -fx-padding: 9 20;"/>

                    <Button fx:id="uploadButton"
                            text="Ganti Foto"
                            onAction="#handleUploadPhoto"
                            style="-fx-background-color: white; -fx-text-fill: #00643d; -fx-border-color: #00643d; -fx-border-radius: 7; -fx-background-radius: 7; -fx-padding: 9 18;"/>
                </HBox>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Hapus Profil"
                    onAction="#handleDelete"
                    style="-fx-background-color: white; -fx-text-fill: #b3261e; -fx-border-color: #b3261e; -fx-border-radius: 7; -fx-background-radius: 7; -fx-padding: 9 16;"/>
        </HBox>

        <Separator/>

        <GridPane hgap="15" vgap="18">
            <columnConstraints>
                <ColumnConstraints minWidth="130"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <Label text="Nama Toko"
                   style="-fx-font-weight: bold;"
                   GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="storeNameField"
                       text="Toko Penyewaan Pendakian Abadi"
                       editable="false"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Email Toko"
                   style="-fx-font-weight: bold;"
                   GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="emailField"
                       text="tokopenyewaanpendakianabadi@gmail.com"
                       editable="false"
                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Lokasi Toko"
                   style="-fx-font-weight: bold;"
                   GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="locationField"
                       text="Jl. Raya Kampus UNUD, Jimbaran, Bali"
                       editable="false"
                       GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        </GridPane>

        <Region VBox.vgrow="ALWAYS"/>

        <HBox alignment="CENTER_RIGHT" spacing="10">
            <Button fx:id="cancelButton"
                    text="Batal"
                    visible="false" managed="false"
                    onAction="#handleCancel"
                    style="-fx-background-color: white; -fx-text-fill: #00643d; -fx-border-color: #00643d; -fx-border-radius: 7; -fx-background-radius: 7; -fx-padding: 10 24;"/>

            <Button fx:id="saveButton"
                    text="Simpan Perubahan"
                    visible="false" managed="false"
                    onAction="#handleSave"
                    style="-fx-background-color: #00643d; -fx-text-fill: white; -fx-background-radius: 7; -fx-font-weight: bold; -fx-padding: 10 24;"/>
        </HBox>
    </VBox>
</VBox>
