<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Satu kartu transaksi -->
<HBox alignment="CENTER_LEFT" prefHeight="119.0" spacing="45.0"
      style="-fx-background-color: #F5F5F5; -fx-background-radius: 10;"
      xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sistemmanajemenpenyewaanperlengkapanpendakian.controller.ItemTransaksiController">
    <children>

        <!-- garis hijau di kiri -->
        <Region minWidth="10.0" prefWidth="10.0" maxHeight="Infinity"
                style="-fx-background-color: #00572B; -fx-background-radius: 10 0 0 10;" />

        <!-- foto barang -->
        <ImageView fx:id="gambarBarang" fitHeight="98.0" fitWidth="92.0" pickOnBounds="true" preserveRatio="true" />

        <!-- nama barang, penyewa, tanggal -->
        <VBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label fx:id="labelNamaBarang" text="Nama Barang"
                       style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: black;" />
                <VBox spacing="2.0">
                    <children>
                        <Label fx:id="labelPenyewa" text="Nama Penyewa"
                               style="-fx-font-size: 14px; -fx-text-fill: #7A7A7A;" />
                        <Label fx:id="labelTanggal" text="00-00-0000 | 00-00-0000"
                               style="-fx-font-size: 14px; -fx-text-fill: #7A7A7A;" />
                    </children>
                </VBox>
            </children>
        </VBox>

        <Region HBox.hgrow="ALWAYS" />

        <!-- status + tombol detail -->
        <VBox alignment="TOP_RIGHT" spacing="40.0" prefWidth="280.0" maxHeight="100.0">
            <children>
                <Label fx:id="labelStatus" alignment="CENTER" maxWidth="180.0" text="Berhasil" />
                <Button fx:id="tombolDetail" maxWidth="150.0" prefWidth="50.0" mnemonicParsing="false" maxHeight="20.0" prefHeight="2.0"
                        onAction="#bukaDetail" text="Detail"
                        style="-fx-font-size: 14px; -fx-background-color: #00572B; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" />
            </children>
            <padding>
                <Insets bottom="8.0" top="6.0" />
            </padding>
        </VBox>

    </children>
    <padding>
        <Insets right="10.0" />
    </padding>
</HBox>
