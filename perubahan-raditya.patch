+        return tipeTas;
+    }
+
+    public void setTipeTas(String tipeTas) {
+        this.tipeTas = tipeTas;
+    }
+
+    @Override
+    public long hitungHargaSewa(int durasiSewa) {
+        if (durasiSewa <= 0) {
+            return 0;
+        }
+        return hargaSewaHarian * durasiSewa;
+    }
 }
